{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "branchPrefix": "chore/renovate-",
  "prConcurrentLimit": 3,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": [
        "samples/**",
        "Examples/**"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "weekly updates"
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "enabled": true,
      "rangeStrategy": "in-range-only",
      "groupName": "sample gem locks"
    }
  ],
  "bundler": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "minimumReleaseAge": "3 days",
  "timezone": "America/Mexico_City",
  "schedule": [
    "before 6am on monday"
  ]
}
